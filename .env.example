# ==== 数据库（pgvector）====
# 本地开发默认指向 docker compose up -d db 启动的实例
LLMKB_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/llm_intel_kb

# ==== 模型供应商（推荐方式）====
# 多供应商在 llm_providers.toml 中配置（本地 + 远程均可），API Key 通过环境变量注入。
# 例如 DeepSeek 的 Key 写在这里（llm_providers.toml 中用 env:LLMKB_DEEPSEEK_API_KEY 引用）：
LLMKB_DEEPSEEK_API_KEY=

# SiliconFlow 等 Embedding 服务（M2 阶段需要时再填）
LLMKB_SILICONFLOW_API_KEY=

# Anthropic Messages 格式的远程 API（llm_providers.toml 中 [dots3] 段引用）
LLMKB_DOTS3_API_KEY=

# ==== 备用：单一供应商模式（仅当不用 llm_providers.toml 时生效）====
LLMKB_LLM_BASE_URL=
LLMKB_LLM_API_KEY=
LLMKB_LLM_MODEL=

LLMKB_EMBEDDING_BASE_URL=
LLMKB_EMBEDDING_API_KEY=
LLMKB_EMBEDDING_MODEL=

# ==== 数据目录（语料快照、版本化存储）====
LLMKB_DATA_DIR=./data
